# OpenAI API key for text-embedding-3-small embedding generation
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key for Claude 3.5 Sonnet generation
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# API authentication token for the compliance query endpoint
API_AUTH_TOKEN=your-api-auth-token-here

# Feature flag to show system diagnostics sidebar in Streamlit app (default: false)
SHOW_DEBUG_SIDEBAR=false

